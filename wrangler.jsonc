{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "outway-club",
	"main": ".open-next/worker.js",
	// nodejs_compat is required by the adapter, and the compatibility date must
	// be 2024-09-23 or later or the Node built-ins it relies on are not present.
	"compatibility_date": "2025-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Backs next/image on Workers. The OpenNext adapter routes /_next/image
	// through this binding, which restores per-device srcset and AVIF/WebP
	// negotiation — the things `images.unoptimized` used to switch off.
	//
	// Billed as Image Transformations, not as Cloudflare Images storage: we
	// transform files we already serve from ASSETS rather than storing them in
	// Cloudflare's image bucket. The Free plan covers 5,000 unique
	// transformations a month and this site needs about 112, so it does not
	// currently cost anything.
	//
	// REQUIRES Images to be enabled for the zone in the Cloudflare dashboard.
	// The binding resolves at deploy time but transformations fail at request
	// time if the zone toggle is off, which takes out every image on the site
	// at once. Enable it before the first deploy that carries this block.
	"images": {
		"binding": "IMAGES"
	},
	// NEXT_INC_CACHE_KV and NEXT_TAG_CACHE_D1 are not our choice of label — they
	// are the exact names the OpenNext adapter looks up. Rename either and the
	// override finds nothing.
	//
	// The two fail very differently, which is worth knowing before debugging one:
	//   KV  — throws an error the adapter classes as ignorable, so the site works
	//         and simply never caches. Silent.
	//   D1  — `opennextjs-cloudflare deploy` fails outright with
	//         `No D1 binding "NEXT_TAG_CACHE_D1" found!`. Loud.
	//
	// `wrangler d1 create` offers to add the binding for you and appends a SECOND
	// entry under its own generated name rather than filling in the one already
	// here. Decline it, or delete the extra afterwards.
	//
	// See docs/cloudflare-deploy.md.
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "c4ce3b900b2e4c549243381c3d5231d4"
		}
	],
	"d1_databases": [
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "outway-club-tags",
			"database_id": "0c86c8ab-bc95-4366-9096-090dff4f5e1b"
		}
	],
	// Public values only. Everything secret (service role key, Razorpay secret,
	// Resend key) is set with `wrangler secret put` and must never appear here —
	// this file is committed. Secrets are stored separately by Cloudflare and
	// survive a deploy; the plain vars below do NOT work that way.
	//
	// THIS BLOCK IS AUTHORITATIVE. A deploy replaces the Worker's entire variable
	// set with exactly what is listed here, silently deleting anything added
	// through the dashboard. Add variables here, not there, or the next deploy
	// removes them.
	//
	// Only runtime-read values belong here. Every NEXT_PUBLIC_* is inlined into
	// the bundle at build time and is already baked in, so listing them would be
	// decoration — except NEXT_PUBLIC_SITE_URL, kept because a wrong value there
	// is the single most damaging misconfiguration in this app.
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://outway.club",

		// Read via process.env at request time, so these genuinely have to exist
		// on the Worker. A real mailbox, deliberately not noreply@: three of the
		// templates in src/lib/email.ts tell the reader to reply to the message.
		"EMAIL_FROM": "Outway Club <hello@outway.club>",

		// Where booking alerts land. `bookings@` and `hello@` are aliases onto
		// one mailbox, so this is about which address the alert is addressed to,
		// not which inbox it reaches — it keeps ops mail filterable.
		//
		// Setting this in .env.local does NOT change production: that file is
		// only read when building on this machine, and OPS_EMAIL is read at
		// request time on the Worker, from this block.
		"OPS_EMAIL": "bookings@outway.club"
	},
	"observability": {
		"enabled": true
	}
}