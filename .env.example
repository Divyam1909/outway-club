# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses row-level security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only used by scripts/db.mjs to apply migrations. Not needed at runtime.
DATABASE_PASS=your-database-password

# ---------------------------------------------------------------------------
# Manual payment details, shown in the "Payment details" block on trip and
# booking pages while online checkout is off (site.paymentsEnabled = false).
#
# The block hides itself unless a UPI ID or a COMPLETE bank account is set —
# a half-filled account number would send someone's money nowhere. Set these
# in Vercel too: they are NEXT_PUBLIC_, so they are baked in at build time.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_IFSC=

# ---------------------------------------------------------------------------
# Razorpay — Dashboard > Settings > API Keys
# Checkout is disabled with a clear message until these are real values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard > Settings > Webhooks. Create one for `payment.captured` pointing
# at https://your-domain/api/razorpay/webhook and paste its secret here. This
# is what records a booking when the customer's browser dies mid-payment —
# without it that money is taken with nothing to show for it.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---------------------------------------------------------------------------
# Transactional email — resend.com > API Keys
#
# Sends booking receipts, cancellation confirmations, enquiry alerts and
# waitlist welcomes. Without it those are skipped with a console warning
# rather than failing the request.
#
# TWO PROVIDERS, ONE DOMAIN, AND THEY DO NOT OVERLAP:
#   Zoho  = the human mailboxes you read and reply from (hello@, bookings@).
#           Zoho's free plan has NO SMTP access, so it cannot send this app's
#           email — it only receives.
#   Resend = everything the app sends. Verify the ROOT domain outway.club in
#           Resend; its MX record lands on `send.outway.club`, which is why it
#           does not collide with Zoho's MX on the root. See
#           docs/production-setup.md.
#
# EMAIL_FROM must stay a real, monitored mailbox: several templates say
# "reply to this email", so a noreply@ address here would break that promise.
#
# Supabase's OWN auth emails (signup confirmation, password reset) are sent by
# Supabase, not by this app. Point Supabase's SMTP settings at Resend too —
# see docs/production-setup.md.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="Outway Club <hello@outway.club>"
# Where booking / enquiry / review alerts land. Defaults to the contact email.
OPS_EMAIL=bookings@outway.club

# ---------------------------------------------------------------------------
# Public site URL — used for canonical tags, sitemap, OG images and email links.
# Must be the real deployed origin in production, with no trailing slash.
#
# Production: https://outway.club  (apex is canonical; www 301s to it)
#
# This is NEXT_PUBLIC_, so it is baked into the bundle at BUILD time. Changing
# it in Vercel does nothing until you redeploy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Business identity — everything below is rendered on the contact page, the
# legal pages, the footer and in structured data.
#
# Anything left blank is OMITTED from the site rather than shown as a
# placeholder. Fill these in before taking real payments: Razorpay activation
# requires a reachable phone number and a registered address to be published.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LEGAL_NAME=Outway Club
NEXT_PUBLIC_CONTACT_EMAIL=hello@outway.club
# Digits only, with country code, e.g. 919876543210. Blank hides WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Display form, e.g. "+91 98765 43210". Blank hides the phone number.
NEXT_PUBLIC_CONTACT_PHONE=
# Full registered address. Blank falls back to the city below.
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_CITY=Udaipur, Rajasthan
NEXT_PUBLIC_GSTIN=

NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/outway.club
NEXT_PUBLIC_YOUTUBE_URL=
